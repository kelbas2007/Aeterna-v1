# Canonical source bytes on Linux and Windows. Frozen source-contract tests
# compare actual Rust declarations, including the newline before the permit.
*.rs text eol=lf
*.py text eol=lf
*.yml text eol=lf
*.toml text eol=lf
# RSP1 was frozen with one whitespace-only line (211). Preserve the exact
# preregistered SHA256 rather than edit policy source after viewing outcomes.
# Source hashes and all semantic/protection tests remain mandatory in CI.
src/construction/search_policy.rs whitespace=-blank-at-eol

# Generated measurements remain downloadable; keep code review readable.
docs/evidence/acquired-rules/** linguist-generated=true
docs/evidence/acquired-rules/protocol.json linguist-generated=false
docs/evidence/first-readout/** linguist-generated=true
docs/evidence/first-readout/protocol.json linguist-generated=false
docs/evidence/first-readout/frozen-probe-protocol.json linguist-generated=false
docs/evidence/first-readout/source-identity.json linguist-generated=false
docs/evidence/first-readout/internet-sources.json linguist-generated=false
docs/evidence/first-readout/*.py linguist-generated=false
docs/evidence/coverage-memory/** linguist-generated=true
docs/evidence/coverage-memory/protocol.json linguist-generated=false
